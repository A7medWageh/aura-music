NODE_ENV=development
NEXT_PUBLIC_APP_NAME=MusicWeb

NEON_DB_HOST=
NEON_DB_PORT=5432
NEON_DB_USERNAME=
NEON_DB_PASSWORD=
NEON_DB_NAME=neondb
NEON_DB_SSL=true
NEON_DB_POOL_MAX=15
NEON_DB_IDLE_TIMEOUT_MS=30000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

YT_DLP_PATH=yt-dlp
AUTH_JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
AUTH_CSRF_SECRET=replace_with_random_value
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_REQUESTS=100

# MusicApi (.NET backend) — set to your deployed API URL
MUSIC_API_BASE_URL=http://localhost:5107
